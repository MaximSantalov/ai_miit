{
  "datamarts": [
    {
      "name": "load",
      "title": "Погрузка",
      "description": "Фактические объёмы погрузки по датам, станциям и дорогам погрузки и назначения, роду подвижного состава, типу парка, держателю контракта, клиентам, группам и классам груза. Одна строка — один погруженный вагон, объём считается суммой показателя loaded_wagons.",
      "base_query": "SELECT * FROM V_DM_LOAD",
      "default_limit": 100,
      "max_limit": 5000,
      "columns": [
        {
          "name": "repdate",
          "expression": "base.REPDATE",
          "role": "dimension",
          "description": "Отчетная дата и время операции",
          "data_type": "datetime"
        },
        {
          "name": "rep_month",
          "expression": "trunc(base.REPDATE, 'mm')",
          "role": "dimension",
          "description": "Отчетный месяц (первое число месяца)",
          "data_type": "date"
        },
        {
          "name": "st_code",
          "expression": "base.ST_CODE",
          "role": "dimension",
          "description": "Код станции",
          "name_column": "st_name"
        },
        {
          "name": "st_name",
          "expression": "base.ST_NAME",
          "role": "dimension",
          "description": "Наим станции",
          "ci_match": true
        },
        {
          "name": "rw_code",
          "expression": "base.RW_CODE",
          "role": "dimension",
          "description": "Код дороги"
        },
        {
          "name": "rw_name",
          "expression": "base.RW_NAME",
          "role": "dimension",
          "description": "Наим дороги",
          "ci_match": true,
          "normalize": "railway"
        },
        {
          "name": "rsv_st_code",
          "expression": "base.RSV_ST_CODE",
          "role": "dimension",
          "description": "Код станции назначения",
          "name_column": "rsv_st_name"
        },
        {
          "name": "rsv_st_name",
          "expression": "base.RSV_ST_NAME",
          "role": "dimension",
          "description": "Наим станции назначения",
          "ci_match": true
        },
        {
          "name": "rsv_rw_code",
          "expression": "base.RSV_RW_CODE",
          "role": "dimension",
          "description": "Код дороги назначения"
        },
        {
          "name": "rsv_rw_name",
          "expression": "base.RSV_RW_NAME",
          "role": "dimension",
          "description": "Наим дороги назначения",
          "ci_match": true,
          "normalize": "railway"
        },
        {
          "name": "rod_id",
          "expression": "base.ROD_ID",
          "role": "dimension",
          "description": "Ид рода подвижного состава"
        },
        {
          "name": "rod_name",
          "expression": "base.ROD_NAME",
          "role": "dimension",
          "description": "Наим рода подвижного состава"
        },
        {
          "name": "c_owner_id",
          "expression": "base.C_OWNER_ID",
          "role": "dimension",
          "description": "Код типа парка (собственника вагонов)"
        },
        {
          "name": "c_hodor_id",
          "expression": "base.C_HODOR_ID",
          "role": "dimension",
          "description": "Код держателя контракта"
        },
        {
          "name": "client_id",
          "expression": "base.CLIENT_ID",
          "role": "dimension",
          "description": "Ид клиента"
        },
        {
          "name": "client_name",
          "expression": "base.CLIENT_NAME",
          "role": "dimension",
          "description": "Наим клиента",
          "ci_match": true,
          "normalize": "client"
        },
        {
          "name": "gg_name",
          "expression": "base.GG_NAME",
          "role": "dimension",
          "description": "Группа груза"
        },
        {
          "name": "fr_class",
          "expression": "base.FR_CLASS",
          "role": "dimension",
          "description": "Класс груза"
        },
        {
          "name": "loaded_wagons",
          "expression": "base.LOADED_WAGONS",
          "role": "metric",
          "description": "Погружено вагонов",
          "data_type": "number",
          "aggregations": [
            "sum",
            "avg_day"
          ]
        },
        {
          "name": "wagnum",
          "expression": "base.WAGNUM",
          "role": "dimension",
          "description": "Номер вагона",
          "data_type": "number"
        }
      ]
    },
